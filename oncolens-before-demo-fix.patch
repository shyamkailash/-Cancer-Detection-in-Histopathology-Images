+function AuthModal({
+  mode,
+  onClose,
+  onSuccess,
+  onSwitchMode,
+}: {
+  mode: 'login' | 'register';
+  onClose: () => void;
+  onSuccess: (u: UserProfile) => void;
+  onSwitchMode: (m: 'login' | 'register') => void;
+}) {
+  const [username, setUsername] = useState('');
+  const [email, setEmail] = useState('');
+  const [password, setPassword] = useState('');
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+
+  const handleSubmit = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setError(null);
+    setLoading(true);
+
+    try {
+      if (mode === 'login') {
+        const res = await api.auth.login(username, password);
+        if (res.data?.token && res.data.user) {
+          authStorage.setToken(res.data.token);
+          authStorage.setUser(res.data.user);
+          onSuccess(res.data.user);
+        } else {
+          setError(res.error || 'Authentication failed. Please verify credentials.');
+        }
+      } else {
+        const res = await api.auth.register(username, email, password);
+        if (res.data?.token && res.data.user) {
+          authStorage.setToken(res.data.token);
+          authStorage.setUser(res.data.user);
+          onSuccess(res.data.user);
+        } else {
+          setError(res.error || 'Registration failed. Check inputs.');
+        }
+      }
+    } catch (err: any) {
+      setError(err.message || 'Network error.');
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  return (
+    <div className="modal-overlay" onClick={onClose}>
+      <div className="modal-card" onClick={(e) => e.stopPropagation()}>
+        <div className="modal-head">
+          <h3>{mode === 'login' ? 'Researcher Sign In' : 'Create Researcher Account'}</h3>
+          <button className="icon-btn" onClick={onClose}>
+            <X size={18} />
+          </button>
+        </div>
+
+        <div className="auth-tabs">
+          <button
+            className={`auth-tab ${mode === 'login' ? 'active' : ''}`}
+            onClick={() => {
+              setError(null);
+              onSwitchMode('login');
+            }}
+          >
+            Sign In
+          </button>
+          <button
+            className={`auth-tab ${mode === 'register' ? 'active' : ''}`}
+            onClick={() => {
+              setError(null);
+              onSwitchMode('register');
+            }}
+          >
+            Register
+          </button>
+        </div>
+
+        {error && <div className="form-error" style={{ marginBottom: 12 }}>{error}</div>}
+
+        <form onSubmit={handleSubmit} className="auth-form">
+          <div className="form-field">
+            <label>Username {mode === 'login' && 'or Email'}</label>
+            <input
+              type="text"
+              required
+              value={username}
+              onChange={(e) => setUsername(e.target.value)}
+              placeholder="e.g. researcher_01"
+            />
+          </div>
+
+          {mode === 'register' && (
+            <div className="form-field">
+              <label>Institutional Email</label>
+              <input
+                type="email"
+                required
+                value={email}
+                onChange={(e) => setEmail(e.target.value)}
+                placeholder="name@hospital.org"
+              />
+            </div>
+          )}
+
+          <div className="form-field">
+            <label>Password</label>
+            <input
+              type="password"
+              required
+              value={password}
+              onChange={(e) => setPassword(e.target.value)}
+              placeholder="••••••••••••"
+            />
+          </div>
+
+          <button className="primary-btn" disabled={loading} type="submit">
+            {loading ? (
+              <>
+                <RefreshCw className="spin" size={14} /> Processing…
+              </>
+            ) : mode === 'login' ? (
+              'Sign In to Console'
+            ) : (
+              'Create Account'
+            )}
+          </button>
+        </form>
+      </div>
+    </div>
+  );
+}
