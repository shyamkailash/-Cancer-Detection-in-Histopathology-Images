 @media(max-width:520px){h1{font-size:16px}.header-actions .live-pill{display:none}.content{padding:24px 15px}.kpi{min-height:115px;padding:13px}.kpi strong{font-size:20px}.kpi-icon{margin-bottom:12px}.chart-card{padding:12px}.chart-footer{flex-wrap:wrap;gap:10px}.chart-source{margin-left:0}.notice{align-items:flex-start;flex-wrap:wrap}.notice button{margin-left:29px}.page-hero{align-items:flex-start;flex-wrap:wrap}.page-hero .live-pill{margin-left:0}.model-row{gap:7px}.model-row .badge{display:none}}
+
+/* Additional Modern Clinical UI Enhancements */
+.badge.red{background:#3b1820;color:#f87171}
+.badge.yellow{background:#382d15;color:#fbbf24}
+.badge-metastasis{background:#451820;color:#fca5a5;border:1px solid #7f1d1d}
+.badge-normal{background:#143828;color:#86efac;border:1px solid #166534}
+
+/* Grad-CAM & Explainability Grid */
+.explain-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:20px 0}
+.explain-card{background:#0a1725;border:1px solid #1a2c3e;border-radius:8px;padding:12px;text-align:center}
+.explain-card h4{font-size:11px;font-family:'DM Mono',monospace;color:#7c94a7;margin:0 0 8px;text-transform:uppercase;letter-spacing:.05em}
+.explain-card img{width:100%;height:180px;object-fit:contain;border-radius:6px;background:#050c14}
+.explain-meta{margin-top:8px;font-size:10px;color:#62798d;font-family:'DM Mono',monospace}
+
+/* Probability Bars */
+.prob-group{display:flex;flex-direction:column;gap:10px;margin:18px 0}
+.prob-row{display:flex;flex-direction:column;gap:5px}
+.prob-label{display:flex;justify-content:space-between;font-size:11px;color:#8ba0b1}
+.prob-track{height:8px;background:#132435;border-radius:99px;overflow:hidden;width:100%}
+.prob-fill-normal{height:100%;background:#36d399;border-radius:99px;transition:width .3s}
+.prob-fill-meta{height:100%;background:#f87171;border-radius:99px;transition:width .3s}
+
+/* Prediction History */
+.history-section{margin-top:28px}
+.history-table{width:100%;border-collapse:collapse;font-size:11px;margin-top:12px}
+.history-table th{text-align:left;color:#6b8296;font-family:'DM Mono',monospace;font-size:10px;padding:9px 12px;border-bottom:1px solid #1c2f42}
+.history-table td{padding:10px 12px;border-bottom:1px solid #152433;color:#d5e2ec}
+.history-table tr:hover td{background:#0f2030}
+.history-thumb{width:36px;height:36px;border-radius:4px;object-fit:cover;vertical-align:middle;margin-right:8px}
+
+/* Data Tables */
+.data-table-container{overflow-x:auto;margin:16px 0;background:#0a1725;border:1px solid #1b2e40;border-radius:8px}
+.data-table{width:100%;border-collapse:collapse;font-size:11px;text-align:left}
+.data-table th{background:#0d1e30;padding:12px 14px;color:#7e94a8;font-family:'DM Mono',monospace;font-size:10px;border-bottom:1px solid #1c3246}
+.data-table td{padding:12px 14px;border-bottom:1px solid #162637;color:#cddae4}
+.data-table tr:last-child td{border-bottom:none}
+
+/* Auth Modal */
+.modal-overlay{position:fixed;inset:0;background:rgba(4,10,18,.8);backdrop-filter:blur(4px);display:flex;align-items:center;justify-content:center;z-index:50;padding:20px}
+.modal-card{background:#0c1a29;border:1px solid #23394e;border-radius:12px;width:100%;max-width:420px;padding:28px;box-shadow:0 20px 40px rgba(0,0,0,.5)}
+.modal-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px}
+.modal-head h3{font-size:16px;margin:0;letter-spacing:-.02em}
+.auth-tabs{display:flex;gap:4px;background:#07121e;padding:3px;border-radius:8px;margin-bottom:20px}
+.auth-tab{flex:1;background:none;border:none;color:#72879a;padding:8px 0;font:600 11px Manrope;border-radius:6px;cursor:pointer;text-align:center}
+.auth-tab.active{background:#172c40;color:#e6edf3}
+.auth-form{display:flex;flex-direction:column;gap:14px}
+.form-field{display:flex;flex-direction:column;gap:6px}
+.form-field label{font-size:10px;font-family:'DM Mono',monospace;color:#7c92a5}
+.form-field input{background:#07121e;border:1px solid #1e3346;border-radius:6px;padding:10px 12px;color:#e6edf3;font-size:12px}
+.form-field input:focus{outline:none;border-color:#36d399}
+.form-error{background:#38171d;border:1px solid #752731;color:#fca5a5;font-size:11px;padding:9px 12px;border-radius:6px}
+.form-success{background:#113824;border:1px solid #1d6945;color:#86efac;font-size:11px;padding:9px 12px;border-radius:6px}
+
+/* Interactive Checkpoint Pill */
+.ckpt-ok{color:#36d399;display:inline-flex;align-items:center;gap:4px;font-size:10px}
+.ckpt-missing{color:#f87171;display:inline-flex;align-items:center;gap:4px;font-size:10px}
